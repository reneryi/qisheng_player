CompileFlags:
  CompilationDatabase: build/clangd
  Add:
    - -std=c++17
    - -Iwindows
    - -Iwindows/flutter/ephemeral
    - -Iwindows/flutter/ephemeral/cpp_client_wrapper/include
    - -Iwindows/flutter/ephemeral/.plugin_symlinks/hotkey_manager_windows/windows
    - -Iwindows/flutter/ephemeral/.plugin_symlinks/screen_retriever/windows
    - -Iwindows/flutter/ephemeral/.plugin_symlinks/window_manager/windows
    - -Iwindows/flutter/ephemeral/.plugin_symlinks/rust_lib_coriander_player/windows
# CompilationDatabase points clangd to the compile_commands.json in the
# build/clangd tree, generated by tools/gen_compile_commands.ps1 (a Ninja
# configure-only build; the Visual Studio generator used by Flutter does not
# support exporting compile_commands.json). The Add flags above act as a
# fallback when the database is missing.
